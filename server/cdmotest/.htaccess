# /var/www/cdmotest.lambda-cro.com: the old address of the test site, now retired.
# The site lives at https://www.lambda-cro.com/CDMOtest. This folder holds the running app (app/), its data and
# settings; nothing here is ever served. Every request is sent to the new address.
Options -Indexes
DirectoryIndex disabled

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ https://www.lambda-cro.com/CDMOtest [R=301,L]
</IfModule>

# If mod_rewrite were ever missing: refuse everything rather than serve files
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
