# Settings the site reads on the server. Copy to .env.local (development) or set them in the host's
# environment (Render dashboard, pm2 ecosystem file, systemd unit...). Never commit real values.

# CMS admin sign-in (/admin). Required in production: without them nobody can sign in.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: secret that signs admin session cookies (32+ random characters).
# When empty it is derived from the password, so changing the password signs everyone out.
ADMIN_SESSION_SECRET=

# Optional: where /virtual-tour links go in production (no trailing slash).
# VIRTUAL_TOUR_URL=https://lambda-virtual-tour.onrender.com
